## 2. 完整流程图

```mermaid
flowchart TD
    A["客户端发送 HTTP 请求"] --> B["Tomcat 解析 HTTP"]
    B --> C["Filter 过滤器链"]
    C --> D["HttpServlet.service()"]
    D --> E["FrameworkServlet.processRequest()"]
    E --> F["DispatcherServlet.doService()"]
    F --> G["DispatcherServlet.doDispatch()"]

    G --> H["HandlerMapping 查找 HandlerMethod"]
    H --> I{"找到 Controller？"}
    I -- "否" --> I1["404"]
    I -- "是" --> J["HandlerMethod + Interceptors"]

    J --> K["选择 HandlerAdapter"]
    K --> L["Interceptor.preHandle()"]
    L --> M{"是否继续？"}
    M -- "否" --> M1["终止处理"]
    M -- "是" --> N["RequestMappingHandlerAdapter"]

    N --> O["ArgumentResolver 解析参数"]
    O --> P["数据绑定与校验"]
    P --> Q["反射调用 Controller"]
    Q --> R["ReturnValueHandler 处理返回值"]

    R --> S{"返回值类型"}
    S -- "ResponseEntity" --> T["HttpEntityMethodProcessor"]
    S -- "@ResponseBody" --> U["RequestResponseBodyMethodProcessor"]
    S -- "视图名" --> V["ViewResolver + View"]
    S -- "redirect:" --> W["RedirectView"]

    T --> X["HttpMessageConverter 写响应体"]
    U --> X
    V --> Y["HTML 响应"]
    W --> Z["3xx 重定向"]
    X --> AA["JSON/XML/文本响应"]

    Y --> AB["afterCompletion()"]
    Z --> AB
    AA --> AB
    AB --> AC["Filter 链返回"]
    AC --> AD["Tomcat 返回 HTTP 响应"]

    G -. "发生异常" .-> AE["HandlerExceptionResolver"]
    AE --> AF{"异常已处理？"}
    AF -- "是" --> R
    AF -- "否" --> AG["异常交给 Servlet 容器"]
```

